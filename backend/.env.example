# Use the Supabase connection pooler string from Project Settings -> Database. This must be the
# CURRENT password -- if it was ever committed to git or otherwise leaked, rotate it in the
# Supabase dashboard first and put the new value here, never a hardcoded default in config.py.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase Auth (Project Settings -> API). SUPABASE_SERVICE_ROLE_KEY is required for admin user
# provisioning (registration, user creation, seeding, password resets) and must never be exposed
# to the frontend or committed.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used by the internal test-token helper (app/core/security.py); not used to sign real
# session tokens in production anymore (Supabase issues those).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
